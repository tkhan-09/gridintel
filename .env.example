# ============================================================
# GridIntel - Environment Configuration
# Copy this file to .env and fill in real values
# ============================================================

# --- Database ---
POSTGRES_USER=gridintel
POSTGRES_PASSWORD=Gr1dInt3l@2024!
POSTGRES_DB=gridintel_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
JWT_SECRET=change-this-to-a-secure-random-256-bit-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Free AI API Keys ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIza_your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# --- Anomaly Detection Thresholds ---
LOSS_THRESHOLD_PERCENT=16.0
AUXILIARY_SPIKE_THRESHOLD=8.0
GENERATION_DROP_THRESHOLD=20.0

# --- App Settings ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OCR Service ---
OCR_SERVICE_URL=http://ocr-service:8001

# --- File Storage ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
